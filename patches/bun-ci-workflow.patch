diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
index cdbd9f2..39572ab 100644
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -17,9 +17,16 @@ jobs:
       - name: gofmt
         run: test -z "$(gofmt -l .)" || (gofmt -l . && exit 1)
       - run: go vet ./...
+      # Node is the runtime zeroauthy launches for Actions, custom database
+      # and social profile scripts (internal/noderunner); it is not the
+      # JavaScript toolchain, which is Bun (tests/e2e/deploy-cli runs the
+      # pinned Deploy CLI handlers with it).
       - uses: actions/setup-node@v4
         with:
           node-version: 26
+      - uses: oven-sh/setup-bun@v2
+        with:
+          bun-version: 1.4.4
       # grpcstore and sqlstore run longer than go test's 10-minute default
       # under -race on hosted runners.
       - run: go test -race -timeout=60m ./...
@@ -44,11 +51,13 @@ jobs:
     runs-on: ubuntu-latest
     steps:
       - uses: actions/checkout@v4
+      - uses: oven-sh/setup-bun@v2
+        with:
+          bun-version: 1.4.4
+      # Only for vue-tsc, which the Makefile runs on Node (see its comment).
       - uses: actions/setup-node@v4
         with:
           node-version: 26
-          cache: npm
-          cache-dependency-path: console/package-lock.json
       - run: make console
       - name: the committed console build and API types are up to date
         run: git diff --exit-code -- console/dist console/src/api/schema.d.ts
@@ -59,14 +68,19 @@ jobs:
       - uses: actions/setup-go@v5
         with:
           go-version-file: go.mod
+      - uses: oven-sh/setup-bun@v2
+        with:
+          bun-version: 1.4.4
+      # Node is not the toolchain here: zeroauthy launches it for the custom
+      # database, Actions and social profile script runtimes (profile scripts
+      # need Node 25+ for permission-enforced network denial; those lanes fail
+      # rather than skip without it).
       - uses: actions/setup-node@v4
         with:
           node-version: 26
-          cache: npm
-          cache-dependency-path: tests/e2e/package-lock.json
-      - run: npm ci --no-audit --no-fund
+      - run: bun install --frozen-lockfile
         working-directory: tests/e2e
-      - run: npx playwright install --with-deps chromium
+      - run: bun --bun x playwright install --with-deps chromium
         working-directory: tests/e2e
       - name: local ACME fixture runtime
         run: sudo apt-get update && sudo apt-get install -y podman podman-compose
@@ -76,11 +90,6 @@ jobs:
       - run: make e2e-branding
       - run: make e2e-email
       - run: make e2e
-      # Social profile scripts need Node 25+ (permission-enforced network
